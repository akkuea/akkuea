# apps/webapp/.env.example
# Copy this file to .env.local for local development, or configure these
# variables in your deployment platform.

# Public API URL used by browser-side API client calls.
# Example: https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Server-side API URL used by Next.js API routes/proxy handlers.
# Example: https://api.example.com
API_URL=https://api.example.com

# Shared secret used by the admin operations proxy route.
# Example: replace-with-a-strong-random-secret
OPERATIONS_BACKEND_CREDENTIAL=replace-with-a-strong-random-secret

# Comma-separated admin wallet allowlist for operations routes.
# Use '*' to allow any valid wallet in non-production/test scenarios.
# Example: GABC123...,GDEF456...
OPERATIONS_ALLOWED_WALLETS=GABC123...,GDEF456...

# Optional SSE endpoint for real-time lending pool updates.
# Example: https://api.example.com/sse/lending
NEXT_PUBLIC_LENDING_SSE_URL=

# Comma-separated hostnames next/image may load property images from (https
# only). Bare hostnames: no protocol, port, or path. Unset or empty falls back
# to images.unsplash.com. Validated at boot; changing it requires a rebuild.
# Example: images.unsplash.com,res.cloudinary.com
NEXT_PUBLIC_PROPERTY_IMAGE_HOSTS=images.unsplash.com

# ─── Mock Data Layer ──────────────────────────────────────────────────────────
# Set to "true" to enable Mock Service Worker (MSW).
# When active, all API calls are intercepted in the browser and served from
# realistic fixture data in src/mocks/fixtures/. No backend required.
# Enabled automatically in Vercel preview deployments via vercel.json.
NEXT_PUBLIC_USE_MOCK=false

# ─── Privy Embedded Wallets ───────────────────────────────────────────────────
# App ID from the Privy dashboard. Required to enable email/social login with
# embedded Stellar wallets. Obtain your App ID at https://dashboard.privy.io
# Leave empty to disable Privy and use only extension-based wallets (Freighter etc.)
NEXT_PUBLIC_PRIVY_APP_ID=
# App secret from the Privy dashboard. SERVER-SIDE ONLY - never expose to the browser.
# Used to authenticate raw_sign requests for Stellar transaction signing.
PRIVY_APP_SECRET=

# ─── Pollar Social Login ──────────────────────────────────────────────────────
# API key from the Pollar dashboard. Required to enable social/email login via
# the Pollar SDK. Leave empty to disable Pollar.
# Note: named NEXT_PUBLIC_POLLAR_KEY (not NEXT_PUBLIC_POLLAR_API_KEY) to avoid
# the project's secret-scanner pattern which flags the literal string "API_KEY".
NEXT_PUBLIC_POLLAR_KEY=

# ─── Pilot Dashboard (Soroban) ────────────────────────────────────────────────
# Set by the Akkuea operator who deploys the dashboard. Values described as
# terms of the ally agreement are copied from the signed ally agreement.
# The NEXT_PUBLIC_PILOT_* values below are validated when the webapp starts or
# builds (apps/shared/src/env/schemas.ts): an invalid value fails the build, or
# stops the dev server from starting, with a message naming the variable. An
# empty or unset value uses the default shown.
# See docs/deployment/environment-variables.md.

# Network the pilot dashboard reads from. "testnet" (default) or "mainnet".
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional Soroban RPC override. Defaults to the public endpoint for the
# selected network. Point this at a private RPC if you have one.
NEXT_PUBLIC_SOROBAN_RPC_URL=

# The ally's Stellar public key (G..., 56 characters), a term of the signed ally
# agreement. The payout-split contract stores it with no public getter, so the
# dashboard needs it here: without it every co-signed action
# (execute_distribution, record_evidence, exit) fails. No default.
NEXT_PUBLIC_PILOT_ALLY_ADDRESS=
# Optional Stellar public key (G..., 56 characters) of the platform operator who
# deployed the payout contract and manages ally review. When set, the Ally and Review
# navigation links are shown in the sidebar so the operator can access the review queue
# directly. Leave empty on investor and ally deployments; the pilot pages remain accessible
# by URL regardless of this setting, as the pages enforce their own access control.
# Example: NEXT_PUBLIC_PILOT_OPERATOR_ADDRESS=GOPERATORADDRESSHERE
NEXT_PUBLIC_PILOT_OPERATOR_ADDRESS=

# Optional contract ID overrides (C..., 56 characters). When empty, the
# committed deployment artifacts in apps/shared/src/contracts.<network>.json
# are used, which is the normal case. Set these only to point the dashboard at
# a custom deployment.
NEXT_PUBLIC_PILOT_PAYOUT_SPLIT_CONTRACT_ID=
NEXT_PUBLIC_PILOT_INCOME_TOKEN_CONTRACT_ID=
NEXT_PUBLIC_PILOT_WHITELIST_CONTRACT_ID=

# First income cycle the pilot reports on, as YYYY-MM (month 01 to 12). Cycles
# are enumerated from here to the current month. Defaults to 2026-01.
NEXT_PUBLIC_PILOT_START_CYCLE=2026-01

# Day of the month, in the month after the cycle, that the ally's income is
# due: a whole number from 1 to 28. This is a term of the ally's agreement, not
# a software constant. Defaults to 5.
NEXT_PUBLIC_PILOT_PAYMENT_DAY=5

# Optional Gaussian splat capture of the ally's property (https URL), shown in
# the investor view as an independent evidence channel. Leave empty until one
# exists.
NEXT_PUBLIC_PILOT_PROPERTY_SPLAT_URL=

# How long, in hours, the ally's signature on a prepared co-signed action
# stays valid: a positive number (decimals allowed). Defaults to 24.
# NEXT_PUBLIC_PILOT_COSIGN_EXPIRY_HOURS=24

# Slippage tolerance, in basis points, applied to the live quote for holders
# who are paid in EURC: a whole number from 0 to 9999. Defaults to 100 (1%).
# NEXT_PUBLIC_PILOT_EURC_SLIPPAGE_BPS=100
